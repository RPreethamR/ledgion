# Copy to .env (gitignored) and fill in. Secrets are read by name from the
# environment at run time; config/default.yaml only stores the variable names.

# Generation (Gemini Flash)
GEMINI_API_KEY=

# Tracing (Langfuse Cloud) — only needed when tracing.enabled=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: override any config/default.yaml knob (prefix LEDGION_, nest with __)
# LEDGION_QDRANT__MODE=memory
# LEDGION_RETRIEVAL__TOP_K=10
